[Unit]
Description=Ethred 360° Tour Panorama Repair Worker
Documentation=https://github.com/ethred/backend
After=network.target

[Service]
Type=simple
User=ethred
Group=ethred
WorkingDirectory=/opt/ethred/backend/repair_worker

# Python environment
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1

# Load secrets from a separate env file (not committed to Git)
EnvironmentFile=/opt/ethred/.env.repair

# Entry point
ExecStart=/opt/ethred/backend/repair_worker/venv/bin/python worker.py

# Restart policy: restart on failure, wait 30s between retries
Restart=on-failure
RestartSec=30

# Logging goes to systemd journal (view with: journalctl -u ethred-repair-worker -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ethred-repair-worker

[Install]
WantedBy=multi-user.target
